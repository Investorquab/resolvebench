# Copy to .env and fill in only the keys you have. A model with a blank key is skipped.
# .env is gitignored. Never commit it and never paste these values anywhere.

# Free keys
XAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Paid, optional
OPENROUTER_API_KEY=

# A NEW, empty wallet used only for anchoring. On Base Sepolia it needs faucet ETH only.
# Do not use a wallet that holds anything else. Leave blank to store roots locally only.
ANCHOR_PRIVATE_KEY=
